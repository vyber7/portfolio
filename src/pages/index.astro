---
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/me.jpg";
import bidLane from "../assets/homepage-desktop.png";
import heatMap from "../assets/heat_map.png";
import drumMachine from "../assets/drum_machine.png";
import calculator from "../assets/calculator.png";
import cv from "../assets/cv.pdf?url";
import ContactForm from "../components/ContactForm";

const supportingWork = [
  {
    title: "Data Heat Map",
    description: "An interactive D3 visualization that turns a dense temperature dataset into a readable visual pattern.",
    image: heatMap,
    href: "https://codepen.io/vyber7/full/xxZjBVr",
    label: "Data visualization",
  },
  {
    title: "Drum Machine",
    description: "A keyboard-accessible browser instrument focused on immediate feedback and compact interaction design.",
    image: drumMachine,
    href: "https://codepen.io/vyber7/full/wvKKjox",
    label: "Interactive UI",
  },
  {
    title: "JavaScript Calculator",
    description: "A state-driven calculator that handles chained operations and a deliberately simple control surface.",
    image: calculator,
    href: "https://codepen.io/vyber7/full/ExVyQeN",
    label: "Application logic",
  },
];
---

<BaseLayout
  title="Websites & Web Apps for Local Businesses — Vitaliy Bernatskyy"
  description="Miami-based developer building and maintaining websites and custom web apps for local businesses. Discuss your website, business tools, or ongoing maintenance with Vitaliy Bernatskyy."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Your local web developer · Miami, FL</p>
      <h1 id="hero-title">Websites & web apps for <em>local businesses.</em></h1>
      <p class="hero-lede">
        I’m Vitaliy. I build websites that help customers find and contact your business, and custom web apps that make day-to-day work easier. I can help you launch, improve what you have, and keep it running.
      </p>
      <div class="actions">
        <a class="button button-primary" href="#contact">Discuss your project</a>
        <a class="button button-quiet" href="#work">Explore selected work</a>
      </div>
      <p class="employer-note">Hiring for your team? <a href="#employers">View my developer background →</a></p>
    </div>
    <div class="portrait-wrap">
      <div class="portrait-meta" aria-hidden="true"><span>01</span><span>AVAILABLE FOR NEW WORK</span></div>
      <img src={portrait.src} alt="Portrait of Vitaliy Bernatskyy" width="928" height="1375" />
    </div>
  </section>

  <section class="services-section shell" id="services" aria-labelledby="services-title">
    <div class="section-heading">
      <p class="section-index">01 / SERVICES</p>
      <h2 id="services-title">The right tools for your business.</h2>
    </div>
    <div class="services-grid">
      <article class="service-card">
        <p class="project-kicker">01 / Websites</p>
        <h3>Help customers find you.</h3>
        <p>A new website or a refresh of your existing one, with clear service information, mobile-friendly pages, and an easy way for customers to get in touch.</p>
      </article>
      <article class="service-card">
        <p class="project-kicker">02 / Custom web apps</p>
        <h3>Make everyday work easier.</h3>
        <p>Tools built around how your business works, such as customer portals, booking workflows, and internal dashboards. We’ll define the features you need before building.</p>
      </article>
      <article class="service-card">
        <p class="project-kicker">03 / Ongoing maintenance</p>
        <h3>Keep your site up to date.</h3>
        <p>Content changes, bug fixes, dependency updates, and improvements as your needs change. We’ll agree on the scope and schedule of ongoing support.</p>
      </article>
    </div>
    <p class="services-next-step">Start with your business and what you need to improve. I’ll help define a practical scope, then agree on the work and timeline with you.</p>
  </section>

  <section class="selected-work shell" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="section-index">02 / SELECTED WORK</p>
      <h2 id="work-title">See what I build.</h2>
    </div>
    <article class="feature-card">
      <a class="feature-image" href="/projects/bidlane/" aria-label="Read the BidLane case study">
        <img src={bidLane.src} alt="BidLane interface showing vehicle listings" width="1920" height="1080" />
      </a>
      <div class="feature-copy">
        <p class="project-kicker">Featured · Full-stack</p>
        <h3>BidLane</h3>
        <p>
          A marketplace where buyers can browse, bid, comment, and follow vehicle auctions as they unfold. The system coordinates authentication, live updates, media, and time-sensitive interaction in one responsive product.
        </p>
        <ul class="stack" aria-label="Technologies used">
          <li>Next.js</li><li>TypeScript</li><li>MongoDB</li><li>Pusher</li>
        </ul>
        <a class="text-link" href="/projects/bidlane/">Read more <span>→</span></a>
      </div>
    </article>
    <div class="supporting-grid">
      {supportingWork.map((project, index) => (
        <a class="supporting-card" href={project.href} target="_blank" rel="noreferrer">
          <div class="supporting-image"><img src={project.image.src} alt={`${project.title} interface`} loading="lazy" /></div>
          <div class="supporting-topline"><span>0{index + 2}</span><span>{project.label}</span></div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="card-link">Open project ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="section-heading about-heading">
        <p class="section-index">03 / ABOUT & APPROACH</p>
        <h2 id="about-title">One developer, from idea to upkeep.</h2>
      </div>
      <div class="about-copy">
        <p class="about-lede">I’m a Miami-based full-stack developer helping local businesses build a useful presence online and tools that support their work.</p>
        <p>
          You work directly with me to turn your needs into a clear plan. I handle the customer-facing pages and the systems behind them, from design and development through deployment and agreed ongoing maintenance.
        </p>
        <p>
          I hold a bachelor’s degree in Computer Science from the International Science and Technology University in Kyiv, Ukraine, and continue to deepen my practice through independent product work.
        </p>
      </div>
      <div class="capability-list" aria-label="Technical capabilities">
        <div><span>Interface</span><p>React · Next.js · TypeScript · Tailwind · CSS</p></div>
        <div><span>Application</span><p>Node.js · APIs · Authentication · Real-time events</p></div>
        <div><span>Data</span><p>MongoDB · Prisma · SQL · Data visualization</p></div>
      </div>
    </div>
  </section>

  <section class="experience-section shell" id="employers" aria-labelledby="experience-title">
    <div class="section-heading">
      <p class="section-index">04 / FOR EMPLOYERS</p>
      <h2 id="experience-title">A developer for your team, too.</h2>
    </div>
    <div class="employer-intro">
      <p>Alongside client projects, I’m open to the right developer role with a team building thoughtful products. Explore my experience below, read the technical case study, or get in touch about an opportunity.</p>
      <div class="actions">
        <a class="button button-quiet" href={cv} target="_blank" rel="noreferrer">View résumé ↗</a>
        <a class="text-link" href="#contact">Discuss a developer role <span>→</span></a>
      </div>
    </div>
    <article class="experience-entry">
      <div class="experience-meta">
        <p>Independent contractor</p>
        <p>2021 · Mitech One LLC</p>
      </div>
      <div class="experience-story">
        <h3>Designed the foundation of a vehicle-auction product.</h3>
        <p>
          Built the initial product experience with WordPress, JavaScript, HTML, and CSS. Registered users could place bids, follow auctions, communicate through comments, and receive update notifications by email.
        </p>
        <p class="outcome">After the contract, the company offered me an ongoing IT position.</p>
      </div>
    </article>
    <div class="credentials-row">
      <p class="credentials-label">Verified learning</p>
      <div>
        <a href="https://www.freecodecamp.org/certification/vyber7/responsive-web-design" target="_blank">Responsive Web Design ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/javascript-algorithms-and-data-structures" target="_blank">JavaScript Algorithms & Data Structures ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/front-end-development-libraries" target="_blank">Front End Libraries ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/data-visualization" target="_blank">Data Visualization ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/back-end-development-and-apis" target="_blank">Back End & APIs ↗</a>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell contact-grid">
      <div>
        <p class="section-index">05 / CONTACT</p>
        <h2 id="contact-title">Let’s build something for your business.</h2>
        <p>Tell me about your business, your current website if you have one, and what you’d like to build or improve. An idea is enough to start the conversation.</p>
        <p>Hiring a developer? Share the role and a little about your team.</p>
        <div class="contact-links">
          <a href="https://github.com/vyber7" target="_blank">GitHub ↗</a>
          <a href="https://codepen.io/vyber7" target="_blank">CodePen ↗</a>
        </div>
      </div>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
