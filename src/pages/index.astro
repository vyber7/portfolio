---
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/me.jpg";
import carAuctions from "../assets/car_auctions.png";
import heatMap from "../assets/heat_map.png";
import drumMachine from "../assets/drum_machine.png";
import calculator from "../assets/calculator.png";
import cv from "../assets/cv.pdf?url";
import ContactForm from "../components/ContactForm";

const supportingWork = [
  {
    title: "Data Heat Map",
    description: "An interactive D3 visualization that turns a dense temperature dataset into a readable visual pattern.",
    image: heatMap,
    href: "https://codepen.io/vyber7/full/xxZjBVr",
    label: "Data visualization",
  },
  {
    title: "Drum Machine",
    description: "A keyboard-accessible browser instrument focused on immediate feedback and compact interaction design.",
    image: drumMachine,
    href: "https://codepen.io/vyber7/full/wvKKjox",
    label: "Interactive UI",
  },
  {
    title: "JavaScript Calculator",
    description: "A state-driven calculator that handles chained operations and a deliberately simple control surface.",
    image: calculator,
    href: "https://codepen.io/vyber7/full/ExVyQeN",
    label: "Application logic",
  },
];
---

<BaseLayout
  title="Vitaliy Bernatskyy — Full-Stack Developer"
  description="Full-stack developer building responsive, real-time web products with React, Next.js, TypeScript, and Node.js."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Full-stack developer · Miami, FL</p>
      <h1 id="hero-title">I turn complex workflows into <em>clear web products.</em></h1>
      <p class="hero-lede">
        I build responsive applications from interface to database, with a focus on real-time experiences, dependable user flows, and maintainable code.
      </p>
      <div class="actions">
        <a class="button button-primary" href="#work">Explore selected work</a>
        <a class="button button-quiet" href={cv} target="_blank">View résumé ↗</a>
      </div>
    </div>
    <div class="portrait-wrap">
      <div class="portrait-meta" aria-hidden="true"><span>01</span><span>AVAILABLE FOR NEW WORK</span></div>
      <img src={portrait.src} alt="Portrait of Vitaliy Bernatskyy" width="928" height="1375" />
    </div>
  </section>

  <section class="selected-work shell" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="section-index">01 / SELECTED WORK</p>
      <h2 id="work-title">Built around a real-time moment.</h2>
    </div>
    <article class="feature-card">
      <a class="feature-image" href="/projects/car-auctions/" aria-label="Read the Car Auctions case study">
        <img src={carAuctions.src} alt="Car Auctions interface showing vehicle listings" width="1920" height="1080" />
      </a>
      <div class="feature-copy">
        <p class="project-kicker">Featured · Full-stack</p>
        <h3>Car Auctions</h3>
        <p>
          A marketplace where buyers can browse, bid, comment, and follow vehicle auctions as they unfold. The system coordinates authentication, live updates, media, and time-sensitive interaction in one responsive product.
        </p>
        <ul class="stack" aria-label="Technologies used">
          <li>Next.js</li><li>TypeScript</li><li>MongoDB</li><li>Pusher</li>
        </ul>
        <a class="text-link" href="/projects/car-auctions/">Read more <span>→</span></a>
      </div>
    </article>
    <div class="supporting-grid">
      {supportingWork.map((project, index) => (
        <a class="supporting-card" href={project.href} target="_blank" rel="noreferrer">
          <div class="supporting-image"><img src={project.image.src} alt={`${project.title} interface`} loading="lazy" /></div>
          <div class="supporting-topline"><span>0{index + 2}</span><span>{project.label}</span></div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="card-link">Open project ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="section-heading about-heading">
        <p class="section-index">02 / APPROACH</p>
        <h2 id="about-title">Across the stack, focused on the user.</h2>
      </div>
      <div class="about-copy">
        <p class="about-lede">I’m a full-stack developer who enjoys the point where product thinking meets implementation.</p>
        <p>
          My work spans responsive interfaces, application state, APIs, authentication, data modeling, and deployment. I’m most useful when a product has several moving parts that need to feel simple to the person using it.
        </p>
        <p>
          I hold a bachelor’s degree in Computer Science from the International Science and Technology University in Kyiv, Ukraine, and continue to deepen my practice through independent product work.
        </p>
      </div>
      <div class="capability-list" aria-label="Technical capabilities">
        <div><span>Interface</span><p>React · Next.js · TypeScript · Tailwind · CSS</p></div>
        <div><span>Application</span><p>Node.js · APIs · Authentication · Real-time events</p></div>
        <div><span>Data</span><p>MongoDB · Prisma · SQL · Data visualization</p></div>
      </div>
    </div>
  </section>

  <section class="experience-section shell" aria-labelledby="experience-title">
    <div class="section-heading">
      <p class="section-index">03 / EXPERIENCE</p>
      <h2 id="experience-title">Commercial context, independent ownership.</h2>
    </div>
    <article class="experience-entry">
      <div class="experience-meta">
        <p>Independent contractor</p>
        <p>2021 · Mitech One LLC</p>
      </div>
      <div class="experience-story">
        <h3>Designed the foundation of a vehicle-auction product.</h3>
        <p>
          Built the initial product experience with WordPress, JavaScript, HTML, and CSS. Registered users could place bids, follow auctions, communicate through comments, and receive update notifications by email.
        </p>
        <p class="outcome">After the contract, the company offered me an ongoing IT position.</p>
      </div>
    </article>
    <div class="credentials-row">
      <p class="credentials-label">Verified learning</p>
      <div>
        <a href="https://www.freecodecamp.org/certification/vyber7/responsive-web-design" target="_blank">Responsive Web Design ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/javascript-algorithms-and-data-structures" target="_blank">JavaScript Algorithms & Data Structures ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/front-end-development-libraries" target="_blank">Front End Libraries ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/data-visualization" target="_blank">Data Visualization ↗</a>
        <a href="https://www.freecodecamp.org/certification/vyber7/back-end-development-and-apis" target="_blank">Back End & APIs ↗</a>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="shell contact-grid">
      <div>
        <p class="section-index">04 / CONTACT</p>
        <h2 id="contact-title">Have a product that needs clarity?</h2>
        <p>Tell me what you’re building, what’s difficult, and where you need help.</p>
        <div class="contact-links">
          <a href="https://github.com/vyber7" target="_blank">GitHub ↗</a>
          <a href="https://codepen.io/vyber7" target="_blank">CodePen ↗</a>
        </div>
      </div>
      <ContactForm client:visible />
    </div>
  </section>
</BaseLayout>
